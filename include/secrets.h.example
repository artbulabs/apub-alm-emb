#pragma once

// ---------------------------------------------------------------------------
// Copy secrets.h.example to secrets.h and fill in your values
// secrets.h – device-specific secrets, NOT committed to git
// ---------------------------------------------------------------------------

// ntfy.sh topic name (keep this private – anyone with this name can
// subscribe to your notifications or send commands to your device)
#define NTFY_TOPIC    "your-secret-topic-here"

// ntfy.sh server URL (use ntfy.sh public server or your own instance)
#define NTFY_SERVER   "https://ntfy.sh"

// WiFi (used on DevKit, or LILYGO when NTFY_TRANSPORT = 1 or 3)
#define WIFI_SSID           "your-wifi-ssid"
#define WIFI_PASS           "your-wifi-password"

// MAC address of ESP32-CAM node
// Run 'mac' command on ESP32-CAM Serial Monitor to get this value
#define CAM_MAC_ADDR  { 0xXX, 0xXX, 0xXX, 0xXX, 0xXX, 0xXX }

// Trusted phone numbers (for missed-call trigger and SMS)
// Add or remove entries as needed
static const char* const TRUSTED_PHONES[] = {
    "+48XXXXXXXXX",   // primary
    // "+48YYYYYYYYY", // secondary (uncomment to enable)
};
static constexpr uint8_t TRUSTED_PHONES_COUNT =
    sizeof(TRUSTED_PHONES) / sizeof(TRUSTED_PHONES[0]);
